{% doc %}
  Renders collection empty-state messaging and a New Arrivals recovery grid.
  @param {collection} collection - The current collection.
  @param {section} section - Collection section settings.
{% enddoc %}
{%- liquid
  assign recovery_collection = section.settings.empty_collection | default: collections['new-arrivals']
-%}
<div class="tps-collection-empty">
  <div class="tps-collection-empty__message">
    <h2 class="h3">{{ 'sections.collection.empty_heading' | t }}</h2>
    <p>{{ 'sections.collection.empty_text' | t }}</p>
    {%- unless recovery_collection.products.size > 0 -%}
      <a class="btn btn--primary" href="{{ routes.all_products_collection_url }}">{{ 'sections.collection.empty_shop_all' | t }}</a>
    {%- else -%}
      <a class="btn btn--primary" href="{{ recovery_collection.url }}">{{ 'sections.collection.empty_view_arrivals' | t }}</a>
    {%- endunless -%}
  </div>
  {%- if recovery_collection.products.size > 0 -%}
    <section class="tps-collection-empty__arrivals" aria-label="{{ 'sections.collection.empty_view_arrivals' | t | escape }}">
      <playtime-favourites class="product-grid product-grid--per-row-{{ section.settings.grid }} product-grid--per-row-mob-{{ settings.prod_thumb_mob_per_row }}">
        {%- for product in recovery_collection.products limit: 12 -%}
          {%- liquid
            assign card_id = section.id | append: '-empty-' | append: product.id
            assign prioritised_loading = false
            if forloop.index0 < section.settings.grid
              assign prioritised_loading = true
            endif
            render 'tps-collection-card', product: product, columns: section.settings.grid, show_vendor: section.settings.show_vendor, prioritised_loading: prioritised_loading, card_id: card_id
          -%}
        {%- endfor -%}
      </playtime-favourites>
    </section>
  {%- endif -%}
</div>

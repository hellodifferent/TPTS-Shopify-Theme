{% doc %}
  Renders a sibling product colour link and its card preview.
  @param {product} sibling - Sibling product to preview.
  @param {product} selected_product - Initially selected product.
  @param {image} selected_image - Initial card image.
{% enddoc %}
{%- liquid
  assign swatch_image = sibling.metafields.custom.swatch_image.value
  assign swatch_colour = sibling.metafields.custom.swatch_colour.value
  assign colour_name = sibling.metafields.custom.swatch_name.value | default: sibling.title
  assign preview_image = sibling.featured_media.preview_image
  if sibling.id == selected_product.id
    assign preview_image = selected_image
  endif
-%}
<li class="pf-swatch-item">
  <a class="pf-swatch" href="{{ sibling.url }}" data-pf-swatch data-product-title="{{ sibling.title | escape }}" data-colour="{{ colour_name | escape }}" data-available="{{ sibling.available }}" aria-label="{{ 'sections.playtime_favourites.view_colour' | t: colour: colour_name | escape }}" aria-current="{% if sibling.id == selected_product.id %}true{% else %}false{% endif %}" title="{{ colour_name | escape }}">
    <span class="pf-swatch-dot"{% if swatch_image != blank %} style="background-image: url('{{ swatch_image | image_url: width: 80 | escape }}');"{% elsif swatch_colour != blank %} style="background-color: {{ swatch_colour | color_to_hex }};"{% endif %}>
      {%- if swatch_image == blank and swatch_colour == blank -%}<span class="pf-swatch-initial" aria-hidden="true">{{ colour_name | slice: 0 | escape }}</span>{%- endif -%}
    </span>
  </a>
  <template data-pf-state>
    <div data-state-visual>
      {%- if preview_image != blank -%}
        {% render 'image', image: preview_image, custom_aspect_ratio: 1, size_cols_desktop: 4, size_cols_mobile: 2, class: 'pf-image', widths: '180, 260, 360, 540, 740, 980', loading: 'lazy' %}
      {%- else -%}
        {{ 'product-1' | placeholder_svg_tag: 'pf-placeholder' }}
      {%- endif -%}
    </div>
    <span data-state-price>{%- if sibling.price_varies -%}{{ 'products.product.from' | t }} {% endif -%}{{ sibling.price | money }}</span>
  </template>
</li>

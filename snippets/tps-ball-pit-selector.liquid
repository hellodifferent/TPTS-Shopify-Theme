{% doc %}
  @param {product} product - Current ball pit or bundle product.
  @param {object} block - Product information block.
{% enddoc %}
{%- liquid
  assign pairings = product.metafields.custom.bundled_pairings.value
  assign pit_only = product.metafields.custom.ball_pit_only.value
  assign mix_heading = 'tps_pit_selector.mix_label' | t
  if pit_only == true
    assign mix_heading = 'tps_pit_selector.add_balls_label' | t
  endif
  assign pit_product = nil
  assign bundle_product = nil
  assign bundle_count = 0
  if pit_only == true
    assign pit_product = product
  endif
  for pairing in pairings
    if pairing != blank and pairing.url != blank
      if pairing.metafields.custom.ball_pit_only.value == true
        assign pit_product = pairing
      else
        assign bundle_count = bundle_count | plus: 1
        if bundle_product == nil
          assign bundle_product = pairing
        endif
        if pairing.id == product.id
          assign bundle_product = pairing
        endif
      endif
    endif
  endfor
-%}
{%- if pit_product != nil -%}
  <div class="tps-pit-selector input-row not-in-quickbuy" {{ block.shopify_attributes }}>
    <h2 class="tps-pit-selector__heading">{{ block.settings.heading | escape }}</h2>
    <nav class="tps-pit-selector__setups" aria-label="{{ 'tps_pit_selector.setup_label' | t | escape }}">
      <a class="tps-pit-selector__option{% if product.id == pit_product.id %} is-selected{% endif %}" href="{{ pit_product.url }}"{% if product.id == pit_product.id %} aria-current="page"{% endif %}>
        <span>{{ 'tps_pit_selector.pit_only' | t }}</span>
        <span class="tps-pit-selector__price">{{ pit_product.price | money }}</span>
      </a>
      {%- if bundle_product != nil -%}
        <a class="tps-pit-selector__option{% if pit_only == false %} is-selected{% endif %}" href="{{ bundle_product.url }}"{% if product.id == bundle_product.id %} aria-current="page"{% endif %}>
          <span>{{ 'tps_pit_selector.with_balls' | t }}</span>
          <span class="tps-pit-selector__price">{{ bundle_product.price | money }}</span>
        </a>
      {%- else -%}
        <span class="tps-pit-selector__option tps-pit-selector__option--pending" aria-disabled="true">
          <span>{{ 'tps_pit_selector.with_balls' | t }}</span>
          <span class="tps-pit-selector__price">{{ 'tps_pit_selector.coming_soon' | t }}</span>
        </span>
      {%- endif -%}
    </nav>
    {%- if bundle_count > 0 -%}
      <div class="tps-pit-selector__mix-title">
        <h3 class="tps-pit-selector__mix-heading">{{ mix_heading | escape }}</h3>
        <tps-ball-colour-guide>
          <button type="button" class="tps-ball-guide__trigger" aria-label="{{ 'tps_pit_selector.view_colour_guide' | t | escape }}" aria-haspopup="dialog">
            <span aria-hidden="true">i</span>
          </button>
          <dialog class="tps-ball-guide__dialog" aria-label="{{ 'tps_pit_selector.colour_guide_title' | t | escape }}">
            <div class="tps-ball-guide__header">
              <h2 class="tps-ball-guide__title">{{ 'tps_pit_selector.colour_guide_title' | t }}</h2>
              <button type="button" class="tps-ball-guide__close" aria-label="{{ 'tps_pit_selector.close_colour_guide' | t | escape }}"><span aria-hidden="true">×</span></button>
            </div>
            <img class="tps-ball-guide__image" data-src="https://cdn.shopify.com/s/files/1/0541/0504/7221/files/TPS_-_Ball_Colours.webp?v=1793580447" width="1094" height="1094" alt="{{ 'tps_pit_selector.colour_guide_alt' | t | escape }}" decoding="async">
          </dialog>
        </tps-ball-colour-guide>
      </div>
      <nav class="tps-pit-selector__mixes" aria-label="{{ mix_heading | escape }}">
        {%- for pairing in pairings -%}
          {%- if pairing != blank and pairing.url != blank and pairing.metafields.custom.ball_pit_only.value != true -%}
            {%- liquid
              assign mix_name = pairing.title | split: ' + 300 Balls - ' | last | remove: ' Mix'
              assign mix_description = ''
              assign mix_colours = ''
              if mix_name == 'Cloud'
                assign mix_colours = 'white,white,transparent'
                assign mix_name = 'tps_pit_selector.cloud' | t
                assign mix_description = 'tps_pit_selector.cloud_description' | t
              elsif mix_name == 'Ocean'
                assign mix_colours = 'white,blue,transparent'
                assign mix_name = 'tps_pit_selector.ocean' | t
                assign mix_description = 'tps_pit_selector.ocean_description' | t
              elsif mix_name == 'Pink Blossom'
                assign mix_colours = 'white,pink,transparent'
                assign mix_name = 'tps_pit_selector.pink_blossom' | t
                assign mix_description = 'tps_pit_selector.pink_description' | t
              endif
            -%}
            <a class="tps-pit-selector__mix{% if pairing.id == product.id %} is-selected{% endif %}" href="{{ pairing.url }}"{% if pairing.id == product.id %} aria-current="page"{% endif %}>
              <span class="tps-pit-selector__mix-header">
                <span class="tps-pit-selector__mix-name">{{ mix_name | escape }}</span>
                {%- if mix_colours != blank -%}
                  {%- assign ball_colours = mix_colours | split: ',' -%}
                  <span class="tps-pit-selector__ball-swatches" aria-hidden="true">
                    {%- for ball_colour in ball_colours -%}
                      <span class="tps-pit-selector__ball-swatch tps-pit-selector__ball-swatch--{{ ball_colour }}"></span>
                    {%- endfor -%}
                  </span>
                {%- endif -%}
              </span>
              {%- if mix_description != blank -%}<span class="tps-pit-selector__mix-description">{{ mix_description | escape }}</span>{%- endif -%}
              {%- unless pairing.available -%}<span class="tps-pit-selector__availability">{{ 'sections.collection.restocking_soon' | t }}</span>{%- endunless -%}
            </a>
          {%- endif -%}
        {%- endfor -%}
      </nav>
    {%- endif -%}
  </div>
{%- endif -%}

{% javascript %}
  if (!customElements.get('tps-ball-colour-guide')) {
    customElements.define('tps-ball-colour-guide', class extends HTMLElement {
      connectedCallback() {
        if (this.initialized) return;
        this.initialized = true;
        const trigger = this.querySelector('.tps-ball-guide__trigger');
        const dialog = this.querySelector('dialog');
        const image = this.querySelector('img');
        const place = () => {
          const gallery = this.closest('.shopify-section')?.querySelector('.tps-product-gallery');
          if (gallery && window.innerWidth >= 768) {
            const bounds = gallery.getBoundingClientRect();
            dialog.style.setProperty('--tps-ball-guide-left', Math.max(16, bounds.left) + 'px');
            dialog.style.setProperty('--tps-ball-guide-width', Math.min(620, bounds.width, window.innerWidth - 32) + 'px');
          }
        };
        trigger.addEventListener('click', () => {
          if (!image.hasAttribute('src')) image.src = image.dataset.src;
          place();
          if (!dialog.open) dialog.showModal();
        });
        this.querySelector('.tps-ball-guide__close').addEventListener('click', () => dialog.close());
        dialog.addEventListener('click', event => {
          if (event.target !== dialog) return;
          const bounds = dialog.getBoundingClientRect();
          if (event.clientX < bounds.left || event.clientX > bounds.right || event.clientY < bounds.top || event.clientY > bounds.bottom) dialog.close();
        });
        this.onResize = () => { if (dialog.open) place(); };
        window.addEventListener('resize', this.onResize);
      }
      disconnectedCallback() {
        window.removeEventListener('resize', this.onResize);
        this.querySelector('dialog')?.close();
        this.initialized = false;
      }
    });
  }
{% endjavascript %}

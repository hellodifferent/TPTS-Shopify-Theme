{% doc %}
  @param {product} product - Current ball pit or bundle product.
  @param {object} block - Product information block.
{% enddoc %}
{%- liquid
  assign pairings = product.metafields.custom.bundled_pairings.value
  assign pit_only = product.metafields.custom.ball_pit_only.value
  assign ball_count = 300
  if product.title contains 'Boucle' or product.title contains 'Bouclé'
    assign ball_count = 200
  endif
  for pairing in pairings
    if pairing.title contains ' Balls - '
      assign ball_count = pairing.title | split: ' + ' | last | split: ' ' | first | plus: 0
      break
    endif
  endfor
  assign mix_heading = 'tps_pit_selector.mix_label' | t
  if pit_only == true
    assign mix_heading = 'tps_pit_selector.add_balls_count_label' | t: count: ball_count
  endif
  assign pit_product = nil
  assign bundle_product = nil
  assign bundle_count = 0
  if pit_only == true
    assign pit_product = product
  endif
  for pairing in pairings
    if pairing != blank and pairing.url != blank
      if pairing.metafields.custom.ball_pit_only.value == true
        assign pit_product = pairing
      else
        assign bundle_count = bundle_count | plus: 1
        if bundle_product == nil
          assign bundle_product = pairing
        endif
        if pairing.id == product.id
          assign bundle_product = pairing
        endif
      endif
    endif
  endfor
-%}
{%- if pit_product != nil -%}
  <div class="tps-pit-selector input-row not-in-quickbuy" {{ block.shopify_attributes }}>
    <h2 class="tps-pit-selector__heading">{{ block.settings.heading | escape }}</h2>
    <nav class="tps-pit-selector__setups" aria-label="{{ 'tps_pit_selector.setup_label' | t | escape }}">
      <a class="tps-pit-selector__option{% if product.id == pit_product.id %} is-selected{% endif %}" href="{{ pit_product.url }}"{% if product.id == pit_product.id %} aria-current="page"{% endif %}>
        <span>{{ 'tps_pit_selector.pit_only' | t }}</span>
        {%- render 'tps-ball-pit-selector-price', product: pit_product -%}
      </a>
      {%- if bundle_product != nil -%}
        <a class="tps-pit-selector__option{% if pit_only == false %} is-selected{% endif %}" href="{{ bundle_product.url }}"{% if product.id == bundle_product.id %} aria-current="page"{% endif %}>
          <span>{{ 'tps_pit_selector.with_balls_count' | t: count: ball_count }}</span>
          {%- render 'tps-ball-pit-selector-price', product: bundle_product -%}
        </a>
      {%- else -%}
        <span class="tps-pit-selector__option tps-pit-selector__option--pending" aria-disabled="true">
          <span>{{ 'tps_pit_selector.with_balls_count' | t: count: ball_count }}</span>
          <span class="tps-pit-selector__price">{{ 'tps_pit_selector.coming_soon' | t }}</span>
        </span>
      {%- endif -%}
    </nav>
    {%- if bundle_count > 0 -%}
      <h3 class="tps-pit-selector__mix-heading">{{ mix_heading | escape }}</h3>
      <nav class="tps-pit-selector__mixes" aria-label="{{ mix_heading | escape }}">
        {%- for pairing in pairings -%}
          {%- if pairing != blank and pairing.url != blank and pairing.metafields.custom.ball_pit_only.value != true -%}
            {%- liquid
              assign mix_name = pairing.title | split: ' Balls - ' | last | remove: ' Mix'
              assign mix_description = ''
              assign mix_colours = ''
              if mix_name == 'Cloud'
                if ball_count == 200
                  assign mix_colours = 'white,transparent'
                else
                  assign mix_colours = 'white,white,transparent'
                endif
                assign mix_name = 'tps_pit_selector.cloud' | t
                if ball_count == 200
                  assign mix_description = 'tps_pit_selector.cloud_200_description' | t
                else
                  assign mix_description = 'tps_pit_selector.cloud_description' | t
                endif
              elsif mix_name == 'Ocean'
                if ball_count == 200
                  assign mix_colours = 'white,blue'
                else
                  assign mix_colours = 'white,blue,transparent'
                endif
                assign mix_name = 'tps_pit_selector.ocean' | t
                if ball_count == 200
                  assign mix_description = 'tps_pit_selector.ocean_200_description' | t
                else
                  assign mix_description = 'tps_pit_selector.ocean_description' | t
                endif
              elsif mix_name == 'Pink Blossom'
                if ball_count == 200
                  assign mix_colours = 'white,pink'
                else
                  assign mix_colours = 'white,pink,transparent'
                endif
                assign mix_name = 'tps_pit_selector.pink_blossom' | t
                if ball_count == 200
                  assign mix_description = 'tps_pit_selector.pink_200_description' | t
                else
                  assign mix_description = 'tps_pit_selector.pink_description' | t
                endif
              endif
            -%}
            <a class="tps-pit-selector__mix{% if pairing.id == product.id %} is-selected{% endif %}" href="{{ pairing.url }}"{% if pairing.id == product.id %} aria-current="page"{% endif %}>
              <span class="tps-pit-selector__mix-header">
                <span class="tps-pit-selector__mix-name">{{ mix_name | escape }}</span>
                {%- if mix_colours != blank -%}
                  {%- assign ball_colours = mix_colours | split: ',' -%}
                  <span class="tps-pit-selector__ball-swatches" aria-hidden="true">
                    {%- for ball_colour in ball_colours -%}
                      <span class="tps-pit-selector__ball-swatch tps-pit-selector__ball-swatch--{{ ball_colour }}"></span>
                    {%- endfor -%}
                  </span>
                {%- endif -%}
              </span>
              {%- if mix_description != blank -%}<span class="tps-pit-selector__mix-description">{{ mix_description | escape }}</span>{%- endif -%}
              {%- unless pairing.available or pairing.tags contains 'exclude-restocking-soon' -%}<span class="tps-pit-selector__availability">{{ 'sections.collection.restocking_soon' | t }}</span>{%- endunless -%}
            </a>
          {%- endif -%}
        {%- endfor -%}
      </nav>
    {%- endif -%}
  </div>
{%- endif -%}


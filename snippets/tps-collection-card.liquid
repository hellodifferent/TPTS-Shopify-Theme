{% doc %}
  @param {product} product - Collection product.
  @param {number} columns - Desktop column count.
  @param {boolean} prioritised_loading - Load first-row images eagerly.
  @param {boolean} show_vendor - Show the product vendor.
  @param {string} [card_id] - Section-specific identifier for card forms.
{% enddoc %}
{%- liquid
  assign card_id = card_id | default: product.id
  assign card_image = product.featured_media.preview_image
  assign family = product.metafields.custom.product_family.value
  assign loading = 'lazy'
  if prioritised_loading
    assign loading = 'eager'
  endif
-%}
<article class="pf-card" data-pf-card>
  <div class="pf-media">
    <a class="pf-image-link" href="{{ product.url }}" data-pf-link aria-label="{{ product.title | escape }}">
      <div data-pf-visual>
        {%- if product.featured_media.media_type == 'video' -%}
          {% render 'tps-card-video', media: product.featured_media, aspect_ratio: 1, columns: columns %}
        {%- elsif card_image != blank -%}
          {% render 'image', image: card_image, custom_aspect_ratio: 1, size_cols_desktop: columns, size_cols_mobile: 2, class: 'pf-image', widths: '180, 260, 360, 540, 740, 980', loading: loading %}
        {%- else -%}
          {{ 'product-1' | placeholder_svg_tag: 'pf-placeholder' }}
        {%- endif -%}
      </div>
    </a>
    <div class="tps-collection-action" data-pf-action>{% render 'tps-collection-action', product: product, card_id: card_id %}</div>
    {%- if settings.prod_sold_out_show -%}
      <div class="product-card-labels" data-pf-badge{% if product.available %} hidden{% endif %}>
        <span class="price-label price-label--sold-out">{{ 'products.product.sold_out' | t }}</span>
        <span class="price-label price-label--notify-me" data-pf-restock-label{% if product.tags contains 'exclude-restocking-soon' %} hidden{% endif %}>{{ 'sections.collection.restocking_soon' | t }}</span>
      </div>
    {%- endif -%}
  </div>
  {%- if show_vendor -%}<p class="tps-collection-vendor">{{ product.vendor | escape }}</p>{%- endif -%}
  <h3 class="pf-title"><a href="{{ product.url }}" data-pf-link data-pf-dynamic-title>{{ product.title | escape }}</a></h3>
  {%- if settings.prod_thumb_show_subtitle and product.metafields.descriptors.subtitle != blank -%}
    <p class="pf-description">{{ product.metafields.descriptors.subtitle | escape }}</p>
  {%- endif -%}
  <div class="pf-price" data-pf-price>
    {% render 'tps-card-price', product: product %}
  </div>
  {%- if family.products.value != blank -%}
    <ul class="pf-swatches" aria-label="{{ 'sections.playtime_favourites.colours' | t: product: product.title | escape }}">
      {% render 'playtime-favourite-swatch', sibling: product, selected_product: product, selected_image: card_image, collection_actions: true, card_id: card_id %}
      {%- for sibling in family.products.value -%}
        {%- if sibling != blank and sibling.id != product.id -%}
          {% render 'playtime-favourite-swatch', sibling: sibling, selected_product: product, selected_image: card_image, collection_actions: true, card_id: card_id %}
        {%- endif -%}
      {%- endfor -%}
    </ul>
  {%- endif -%}
  {%- if settings.enable_product_reviews_collection and product.metafields.reviews.rating_count != blank -%}
    {%- assign rating_count = product.metafields.reviews.rating_count | plus: 0 -%}
    {%- if rating_count > 0 -%}
      <div class="tps-collection-rating">{% render 'rating', rating_value: product.metafields.reviews.rating.value, rating_count: rating_count %}</div>
    {%- endif -%}
  {%- endif -%}
  <span class="visually-hidden" role="status" aria-live="polite" aria-atomic="true" data-pf-announcement></span>
</article>

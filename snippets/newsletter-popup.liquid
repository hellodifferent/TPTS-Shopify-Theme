{%- comment -%}
  ============================================================
  NEWSLETTER POPUP + TEASER TAB  (split-panel, image left)
  ------------------------------------------------------------
  Klaviyo-style email capture with a bottom-left teaser tab.
  Desktop: lifestyle image on the left, form on the right.
  Mobile: image hidden, form only.

  Collects email, subscribes the shopper as a Shopify customer,
  tags them "newsletter, popup". Submits via hidden iframe
  (native post) so there's no 400 and no page reload.

  EDIT COPY: kicker / headline / body / button text in the markup.
  EDIT IMAGE: the np_image assign just below.
  EDIT TIMING: CONFIG at the top of the <script>.

  INSTALL: render ONCE before </body> in layout/theme.liquid:
    {% render 'newsletter-popup' %}
  ============================================================
{%- endcomment -%}

{%- assign np_image = 'https://cdn.shopify.com/s/files/1/0541/0504/7221/files/Photo_2-6-2025_5_39_55_PM_22.jpg?v=1749000938' -%}

<div class="np" data-np>

  {%- comment -%} ---------- TEASER TAB (bottom-left) ---------- {%- endcomment -%}
  <button type="button" class="np__teaser" data-np-teaser aria-label="Open newsletter signup">
    {% comment %} <svg class="np__teaser-icon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
      <rect x="3" y="5" width="18" height="14" rx="2"></rect>
      <path d="m3 7 9 6 9-6"></path>
    </svg> {% endcomment %}
    <span>EOFY OFFER</span>
  </button>

  {%- comment -%} ---------- POPUP ---------- {%- endcomment -%}
  <div class="np__overlay" data-np-overlay>
    <div class="np__modal" role="dialog" aria-modal="true" aria-label="Newsletter signup">

      <aside class="np__media" style="background-image: url('{{ np_image }}');" aria-hidden="true"></aside>

      <div class="np__body">
        <button type="button" class="np__close" data-np-close aria-label="Close">&times;</button>

        {%- comment -%} ----- FORM VIEW ----- {%- endcomment -%}
        <div data-np-view="form">
          <h2 class="np__title">Get 15% OFF<br><i>your first order</i></h2>
          <p class="np__text"><strong>Limited time offer • 48 hours only</strong></p>
          <p class="np__text">Sign up for early access to new arrivals, restocks &mdash; plus the occasional little special treat.</p>

          {%- form 'customer', id: 'np_signup' -%}
            <input type="hidden" name="contact[tags]" value="newsletter, popup">

            <label class="np__sr-only" for="np-email">Email address</label>
            <input
              type="email"
              id="np-email"
              name="contact[email]"
              class="np__input"
              placeholder="Email address"
              autocomplete="email"
              data-np-email
              required>

            <button type="button" class="btn btn--large np__submit" data-np-submit>Join us</button>

            <p class="np__error" data-np-error hidden>Something went wrong &mdash; please try again.</p>
          {%- endform -%}

          {% comment %} <p class="np__fine">No spam, just the good bits. Unsubscribe any time.</p> {% endcomment %}
        </div>

        {%- comment -%} ----- SUCCESS VIEW ----- {%- endcomment -%}
        <div data-np-view="success" hidden>
          <h2 class="np__title">Welcome to <br>The Playtime Store</h2>
          <p class="np__text">Use your code: <strong>PLAY15-ZPQL</strong> at checkout</p>
          <p class="np__text"><i>valid for 48 hours only</i></p>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  :root { --np-accent: #f7e1cc; }

  .np__sr-only {
    position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0;
  }

  /* ---- Teaser tab ---- */
  .np__teaser {
    position: fixed;
    left: 20px;
    bottom: 20px;
    z-index: 9998;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 11px 18px;
    border: 0;
    border-radius: 999px;
    background: var(--np-accent);
    color: #3a2f23;
    font-size: 1.2rem;
    font-weight: 600;
    font-family: "DM Sans","HelveticaNeue","Helvetica Neue",Helvetica,Arial,sans-serif;
    cursor: pointer;
    box-shadow: 0 8px 22px rgba(0, 0, 0, 0.20);
    opacity: 0;
    transform: translateX(-130%);
    transition: opacity 0.25s ease, transform 0.3s ease, filter 0.15s ease;
    pointer-events: none;
  }
  .np__teaser.np--show { opacity: 1; transform: translateX(0); pointer-events: auto; }
  .np__teaser:hover { filter: brightness(0.97); }
  .np__teaser-icon { flex: 0 0 auto; }

  /* ---- Overlay ---- */
  .np__overlay {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 16px;
    background: rgba(28, 22, 16, 0.55);
    backdrop-filter: blur(2px);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.28s ease, visibility 0.28s ease;
  }
  .np__overlay.np--open { opacity: 1; visibility: visible; pointer-events: auto; }

  /* ---- Modal ---- */
  .np__modal {
    position: relative;
    display: flex;
    align-items: stretch;
    width: 100%;
    max-width: 760px;
    background: #fff;
    border-radius: 14px;
    overflow: hidden;
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.32);
    transform: translateY(16px) scale(0.99);
    transition: transform 0.3s ease;
  }
  .np__overlay.np--open .np__modal { transform: translateY(0) scale(1); }

  .np__media {
    flex: 0 0 45%;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    min-height: 440px;
  }

  .np__body {
    display: flex;
    align-items: center;
    flex: 1 1 auto;
    padding: 48px 40px 36px;
    font-family: "DM Sans","HelveticaNeue","Helvetica Neue",Helvetica,Arial,sans-serif;
  }

  .np__close {
    position: absolute;
    top: 14px;
    right: 16px;
    width: 32px; height: 32px;
    display: flex; align-items: center; justify-content: center;
    background: rgba(255,255,255,0.85);
    border: 0;
    border-radius: 50%;
    font-size: 22px;
    line-height: 1;
    color: #6b6155;
    cursor: pointer;
    transition: background 0.15s ease, color 0.15s ease;
  }
  .np__close:hover { background: #fff; color: #222; }

  .np__kicker {
    margin: 0 0 12px;
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    font-weight: 700;
    color: #a08763;
  }

  .np__title {
    margin: 0 0 12px;
    font-size: 2.25rem;
    line-height: 1.12;
    color: #211c16;
    font-family: var(--font-heading-family, Georgia, "Times New Roman", serif);
    font-weight: 500;
  }

  .np__text {
    margin: 0 0 24px;
    font-size: 0.98rem;
    line-height: 1.55;
    color: #4a4543;
  }

  .np__input {
    width: 100%;
    box-sizing: border-box;
    padding: 14px 16px;
    margin: 0 0 12px;
    border: 1px solid #d9d2c8;
    border-radius: 8px;
    font-size: 1rem;
    font-family: inherit;
    color: #222;
    background: #fbfaf8;
  }
  .np__input::placeholder { color: #9b938a; }
  .np__input:focus {
    outline: none;
    border-color: var(--np-accent);
    background: #fff;
    box-shadow: 0 0 0 3px rgba(210, 188, 166, 0.35);
  }

  .np__submit {
    width: 100%;
    {% comment %} padding: 14px 16px;
    border: 0;
    background: var(--np-accent);
    color: #2f261b;
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 0.01em;
    font-family: inherit;
    cursor: pointer; {% endcomment %}
    margin-top: 10px;
    border-radius: 0px!important;
    transition: filter 0.15s ease;
  }
  .np__submit:hover { filter: brightness(0.96); }
  .np__submit[disabled] { opacity: 0.6; cursor: default; }

  .np__fine {
    margin: 14px 0 0;
    font-size: 0.78rem;
    color: #a39b90;
  }

  .np__error {
    margin: 14px 0 0;
    padding: 10px 12px;
    border-radius: 6px;
    background: #fcd6d7;
    color: #C72E2F;
    font-size: 0.85rem;
  }

  /* ---- Mobile: hide image, single column ---- */
  @media (max-width: 600px) {
    .np__media { display: none; }
    .np__modal { max-width: 420px; }
    .np__body { padding: 40px 26px 30px; }
    .np__title { font-size: 1.7rem; }
    .np__teaser span { display: inline; }
  }

  @media (prefers-reduced-motion: reduce) {
    .np__teaser, .np__overlay, .np__modal { transition: none; }
  }
</style>

<script>
  (function () {
    var root = document.querySelector('[data-np]');
    if (!root || root.dataset.npBound) return;
    root.dataset.npBound = '1';

    // ---- CONFIG ----
    var CONFIG = {
      openDelayMs: 4000,    // auto-open this long after page load
      reopenAfterDays: 7    // after a dismiss, wait this long before auto-opening again
    };

    function getFlag(k) { try { return localStorage.getItem(k); } catch (e) { return null; } }
    function setFlag(k, v) { try { localStorage.setItem(k, v); } catch (e) {} }

    if (getFlag('np:subscribed') === '1') return; // already subscribed → show nothing

    var overlay  = root.querySelector('[data-np-overlay]');
    var teaser   = root.querySelector('[data-np-teaser]');
    var closeBtn = root.querySelector('[data-np-close]');
    var formEl   = root.querySelector('form');
    var emailEl  = root.querySelector('[data-np-email]');
    var submitEl = root.querySelector('[data-np-submit]');
    var errorEl  = root.querySelector('[data-np-error]');
    var formView = root.querySelector('[data-np-view="form"]');
    var okView   = root.querySelector('[data-np-view="success"]');

    // Hidden iframe sink: native post, no 400, no reload.
    var sinkName = 'np-sink';
    var sink = document.createElement('iframe');
    sink.name = sinkName;
    sink.setAttribute('aria-hidden', 'true');
    sink.style.display = 'none';
    document.body.appendChild(sink);
    formEl.setAttribute('target', sinkName);

    var hasSubmitted = false, failTimer = null;

    sink.addEventListener('load', function () {
      if (!hasSubmitted) return;
      hasSubmitted = false;
      clearTimeout(failTimer);
      setFlag('np:subscribed', '1');
      formView.hidden = true;
      okView.hidden = false;
      teaser.classList.remove('np--show');
    });

    function openModal()  { overlay.classList.add('np--open'); teaser.classList.remove('np--show'); setTimeout(function () { if (emailEl) emailEl.focus(); }, 60); }
    function showTeaser() { if (getFlag('np:subscribed') !== '1') teaser.classList.add('np--show'); }
    function closeModal() { overlay.classList.remove('np--open'); showTeaser(); }
    function dismiss()    { setFlag('np:dismissedAt', String(Date.now())); closeModal(); }

    closeBtn.addEventListener('click', dismiss);
    overlay.addEventListener('click', function (e) { if (e.target === overlay) dismiss(); });
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && overlay.classList.contains('np--open')) dismiss();
    });
    teaser.addEventListener('click', openModal);

    function doSubmit() {
      if (!emailEl.value.trim() || !emailEl.checkValidity()) { emailEl.reportValidity(); return; }
      errorEl.hidden = true;
      submitEl.disabled = true;
      hasSubmitted = true;
      formEl.submit();
      clearTimeout(failTimer);
      failTimer = setTimeout(function () {
        if (hasSubmitted) { hasSubmitted = false; errorEl.hidden = false; submitEl.disabled = false; }
      }, 15000);
    }

    submitEl.addEventListener('click', function (e) { e.preventDefault(); doSubmit(); });
    formEl.addEventListener('submit',  function (e) { e.preventDefault(); doSubmit(); });

    // ---- Initial state ----
    showTeaser();
    var dismissedAt = parseInt(getFlag('np:dismissedAt') || '0', 10);
    var reopenMs = CONFIG.reopenAfterDays * 86400000;
    if (!dismissedAt || (Date.now() - dismissedAt) > reopenMs) {
      setTimeout(openModal, CONFIG.openDelayMs);
    }
  })();
</script>

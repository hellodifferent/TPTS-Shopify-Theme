{% doc %}
  @param {section} section - Section whose spacing settings should be applied.
  @param {string} target - Selector for the section's content wrapper.
{% enddoc %}
{% style %}
  {% if section.settings.custom_vertical_padding %}
    #shopify-section-{{ section.id }} {{ target }} {
      margin-top: 0;
      margin-bottom: 0;
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  {% endif %}
  {% if section.settings.background_color != blank %}
    #shopify-section-{{ section.id }} > .tps-rich-text {
      background-color: {{ section.settings.background_color }};
    }
  {% endif %}
{% endstyle %}

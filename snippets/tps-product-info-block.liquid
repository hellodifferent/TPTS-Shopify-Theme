{% doc %}
  @param {block} block - Product delivery or benefits block.
  @param {product} product - Current product.
{% enddoc %}
{%- liquid
  assign show_block = true
  if product.gift_card?
    assign show_block = false
  endif
  if block.type == 'tps_product_benefits'
    assign scope_title = block.settings.product_title_contains | strip | downcase
    assign current_title = product.title | downcase
    if scope_title != blank
      unless current_title contains scope_title
        assign show_block = false
      endunless
    endif
    if block.settings.introduction == blank and block.settings.benefit_1 == blank and block.settings.benefit_2 == blank and block.settings.benefit_3 == blank
      assign show_block = false
    endif
  endif
-%}
{%- if show_block -%}
  {%- case block.type -%}
    {%- when 'tps_delivery_links' -%}
      <div class="tps-product-delivery not-in-quickbuy" {{ block.shopify_attributes }}>
        {%- if block.settings.shipping_text != blank -%}
          <div class="tps-product-delivery__origin">
            {% render 'icon', icon: 'truck', size: 'small' %}
            <span>{{ block.settings.shipping_text | escape }}</span>
          </div>
        {%- endif -%}
        <div class="tps-product-delivery__links">
          {%- if block.settings.delivery_label != blank and block.settings.delivery_url != blank -%}
            <a href="{{ block.settings.delivery_url | escape }}">
              {% render 'icon', icon: 'box', size: 'small' %}
              <span>{{ block.settings.delivery_label | escape }}</span>
            </a>
          {%- endif -%}
          {%- if block.settings.returns_label != blank and block.settings.returns_url != blank -%}
            <a href="{{ block.settings.returns_url | escape }}">
              {% render 'icon', icon: 'return', size: 'small' %}
              <span>{{ block.settings.returns_label | escape }}</span>
            </a>
          {%- endif -%}
        </div>
      </div>
    {%- when 'tps_product_benefits' -%}
      <div class="tps-product-benefits not-in-quickbuy" style="--tps-benefits-background: {{ block.settings.background | escape }};" {{ block.shopify_attributes }}>
        {%- if block.settings.introduction != blank -%}
          <p>{{ block.settings.introduction | escape | newline_to_br }}</p>
        {%- endif -%}
        {%- if block.settings.benefit_1 != blank or block.settings.benefit_2 != blank or block.settings.benefit_3 != blank -%}
          <ul role="list">
            {%- for index in (1..3) -%}
              {%- assign benefit_key = 'benefit_' | append: index -%}
              {%- assign benefit = block.settings[benefit_key] -%}
              {%- if benefit != blank -%}
                <li>{% render 'icon', icon: 'check_mark', size: 'small' %}<span>{{ benefit | escape }}</span></li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>
  {%- endcase -%}
{%- endif -%}

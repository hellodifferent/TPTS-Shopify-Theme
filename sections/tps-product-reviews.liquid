{{ 'tps-product-reviews.css' | asset_url | stylesheet_tag }}
<tps-product-reviews class="tps-product-reviews" style="--tps-review-feature-bg: {{ section.settings.feature_background }}; --tps-review-list-bg: {{ section.settings.reviews_background }};" data-feature-limit="{{ section.settings.feature_count }}" data-open-label="{{ 'tps_reviews.open_review' | t | escape }}" data-rated-label="{{ 'tps_reviews.rated' | t | escape }}" data-rating-label="{{ 'tps_reviews.rating_label' | t | escape }}" data-read-label="{{ 'tps_reviews.read_review' | t | escape }}">
  {% if section.settings.show_featured %}
    <div data-store-review-source hidden aria-hidden="true">
      {% for block in section.blocks %}
        {% if block.id contains 'all_reviews_page' %}
          {% render block %}
        {% endif %}
      {% endfor %}
    </div>
    <section class="tps-review-feature" data-review-feature hidden aria-labelledby="tps-review-feature-title-{{ section.id }}">
      <div class="tps-review-feature__inner">
        <div class="tps-review-feature__intro">
          <p class="tps-review-eyebrow">{{ section.settings.eyebrow | escape }}</p>
          <h2 id="tps-review-feature-title-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
          <p class="tps-review-feature__summary" data-review-summary></p>
          <div class="tps-review-feature__controls">
            <button type="button" data-review-previous aria-label="{{ 'tps_reviews.previous' | t }}" disabled>{% render 'icon-chevron-left' %}</button>
            <button type="button" data-review-next aria-label="{{ 'tps_reviews.next' | t }}">{% render 'icon-chevron-right' %}</button>
          </div>
        </div>
        <div class="tps-review-feature__track" data-review-track tabindex="0" role="region" aria-label="{{ section.settings.heading | escape }}"></div>
      </div>
    </section>
  {% endif %}
  <dialog class="tps-review-story-dialog" data-story-dialog aria-labelledby="tps-story-title-{{ section.id }}">
    <button type="button" class="tps-review-story-dialog__close" data-story-close aria-label="{{ 'general.navigation.close' | t | escape }}">{% render 'icon-close' %}</button>
    <p class="tps-review-feature__stars" data-story-stars></p>
    <h3 id="tps-story-title-{{ section.id }}" data-story-title></h3>
    <blockquote data-story-quote></blockquote>
  </dialog>
</tps-product-reviews>
<script src="{{ 'tps-product-reviews.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "TPS customer stories",
  "enabled_on": { "templates": ["product", "index"] },
  "settings": [
    { "type": "checkbox", "id": "show_featured", "label": "Show featured customer stories", "default": true },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Playtime, in real life" },
    { "type": "text", "id": "heading", "label": "Featured heading", "default": "Loved by little ones. Trusted by parents." },
    { "type": "range", "id": "feature_count", "label": "Featured cards", "min": 2, "max": 8, "step": 1, "default": 6 },
    { "type": "color", "id": "feature_background", "label": "Featured background", "default": "#e8d8c6" },
    { "type": "paragraph", "content": "Featured cards use published reviews and customer photos/videos from across the store, alternating quotes and media. Manage reviews and widget options in Judge.me." }
  ],
  "blocks": [{ "type": "@app" }],
  "presets": [{ "name": "TPS customer stories" }]
}
{% endschema %}

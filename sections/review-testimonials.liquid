{%- liquid
  assign image_aspect_ratio = 1
  if section.settings.image_shape == 'landscape'
    assign image_aspect_ratio = 1.25
  elsif section.settings.image_shape == 'portrait'
    assign image_aspect_ratio = 0.8
  elsif section.settings.image_shape == 'natural'
    assign image_aspect_ratio = false
  endif
  assign show_image = true
  if section.settings.layout == 'no-image'
    assign show_image = false
  endif
  assign use_slideshow = false
  if section.blocks.size > 1
    assign use_slideshow = true
  endif
-%}
{{ 'tps-expert-testimonials.css' | asset_url | stylesheet_tag }}
{%- if use_slideshow -%}<script src="{{ 'slideshow.js' | asset_url }}" defer></script>{%- endif -%}
<section class="tps-expert" style="--tps-expert-bg: {{ section.settings.background }}; --tps-expert-padding: {{ section.settings.vertical_padding }}px; --tps-expert-font: {{ section.settings.quote_text_size }}px; --tps-expert-mobile-font: {{ section.settings.quote_text_size_mobile }}px;"{% if section.settings.title != blank %} aria-labelledby="ExpertTitle-{{ section.id }}"{% endif %}>
  <div class="container tps-expert__layout">
    {%- if section.settings.title != blank -%}<h2 id="ExpertTitle-{{ section.id }}" class="tps-expert__heading">{{ section.settings.title | escape }}</h2>{%- endif -%}
    <div class="tps-expert__body">
      {%- if use_slideshow -%}
        <slide-show role="region" aria-label="{{ section.settings.title | escape }}" data-autoplay="{{ section.settings.autoplay }}" data-speed="{{ section.settings.autoplay_speed }}" data-transition="fade" data-transition-out-delay="0" data-pause-autoplay-on-mouseover="true">
          <div class="slideshow" id="ExpertSlides-{{ section.id }}" aria-live="polite" aria-atomic="true">
      {%- endif -%}
      {%- for block in section.blocks -%}
        {%- liquid
          assign full_text = block.settings.testimonial | replace: '<br>', ' ' | strip_html | strip
          assign preview_text = block.settings.preview_quote | default: full_text | truncatewords: 40
        -%}
        {%- if use_slideshow -%}<div class="slideshow__slide{% if forloop.first %} is-active{% endif %}" style="--slide-index: {{ forloop.index0 }}">{%- endif -%}
          <article class="tps-expert__card{% if show_image == false or block.settings.image == blank %} tps-expert__card--no-image{% endif %}{% if section.settings.layout == 'image-right' %} tps-expert__card--image-right{% endif %}" {{ block.shopify_attributes }}>
            {%- if show_image and block.settings.image != blank -%}
              <figure class="tps-expert__portrait">
                {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}" aria-label="{{ block.settings.author | escape }}">{%- endif -%}
                {% render 'image', image: block.settings.image, custom_aspect_ratio: image_aspect_ratio, sizes: '84px', widths: '84, 168, 252', loading: 'lazy' %}
                {%- if block.settings.link != blank -%}</a>{%- endif -%}
                {%- if block.settings.image_caption != blank -%}<figcaption>{{ block.settings.image_caption | escape }}</figcaption>{%- endif -%}
              </figure>
            {%- endif -%}
            <div class="tps-expert__content">
              <header class="tps-expert__identity">
                {%- if block.settings.author != blank -%}<h3>{{ block.settings.author | escape }}</h3>{%- endif -%}
                {%- if block.settings.sub-heading != blank -%}<p>{{ block.settings.sub-heading | escape }}</p>{%- endif -%}
              </header>
              {%- if block.settings.star_rating > 0 -%}<div class="tps-expert__stars" aria-label="{{ block.settings.star_rating }} {{ 'tps_reviews.rating_label' | t }}">{%- for i in (1..block.settings.star_rating) -%}<span aria-hidden="true">{% render 'icon-star' %}</span>{%- endfor -%}</div>{%- endif -%}
              {%- if full_text != blank -%}
                {%- if preview_text != full_text -%}
                  <details class="tps-expert__details">
                    <summary><span class="tps-expert__excerpt{% if section.settings.text_caps %} tps-expert__quote--caps{% endif %}">{{ preview_text | escape }}</span><span class="tps-expert__read"><span class="tps-expert__closed-label">{{ 'tps_experts.read_full' | t }}</span><span class="tps-expert__open-label">{{ 'tps_experts.show_less' | t }}</span></span></summary>
                    <blockquote class="tps-expert__quote{% if section.settings.text_caps %} tps-expert__quote--caps{% endif %}">{% render 'multiline-text', multiline-text: block.settings.testimonial %}</blockquote>
                  </details>
                {%- else -%}
                  <blockquote class="tps-expert__quote{% if section.settings.text_caps %} tps-expert__quote--caps{% endif %}">{% render 'multiline-text', multiline-text: block.settings.testimonial %}</blockquote>
                {%- endif -%}
              {%- endif -%}
            </div>
          </article>
        {%- if use_slideshow -%}</div>{%- endif -%}
      {%- endfor -%}
      {%- if use_slideshow -%}
          </div>
          <div class="slideshow-nav tps-expert__nav">
            <button type="button" name="prev" aria-controls="ExpertSlides-{{ section.id }}" aria-label="{{ 'general.slider.previous' | t }}">{% render 'icon-chevron-left' %}</button>
            <span class="tps-expert__counter" aria-hidden="true"><span class="slideshow-nav__counter-current">1</span> / {{ section.blocks.size }}</span>
            <button type="button" name="next" aria-controls="ExpertSlides-{{ section.id }}" aria-label="{{ 'general.slider.next' | t }}">{% render 'icon-chevron-right' %}</button>
          </div>
        </slide-show>
      {%- endif -%}
    </div>
  </div>
</section>
{% javascript %}
document.addEventListener('toggle', event => {
  if (!event.target.matches('.tps-expert__details')) return;
  const slideshow = event.target.closest('slide-show');
  if (!slideshow || !slideshow.stopAutoplay) return;
  if (event.target.open) {
    if (slideshow.expertAutoplay === undefined) slideshow.expertAutoplay = slideshow.autoplayEnabled;
    slideshow.autoplayEnabled = false;
    slideshow.stopAutoplay();
  } else if (!slideshow.querySelector('details[open]') && slideshow.expertAutoplay !== undefined) {
    slideshow.autoplayEnabled = slideshow.expertAutoplay;
    delete slideshow.expertAutoplay;
    if (slideshow.autoplayEnabled) slideshow.startAutoplay();
  }
}, true);
{% endjavascript %}
{% schema %}
{
  "name": "Review Testimonials",
  "class": "section-testimonials review-testimonials",
  "disabled_on": {
    "groups": [
      "aside"
    ]
  },
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Customer reviews"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        {
          "value": "image-left",
          "label": "Image left"
        },
        {
          "value": "image-right",
          "label": "Image right"
        },
        {
          "value": "no-image",
          "label": "No image"
        }
      ],
      "default": "image-right"
    },
    {
      "type": "checkbox",
      "id": "text_caps",
      "label": "Capitalize text",
      "default": false
    },
    {
      "type": "range",
      "id": "quote_text_size",
      "min": 14,
      "max": 50,
      "step": 1,
      "unit": "px",
      "label": "Desktop quote text size",
      "default": 30
    },
    {
      "type": "range",
      "id": "quote_text_size_mobile",
      "min": 14,
      "max": 40,
      "step": 1,
      "unit": "px",
      "label": "Mobile quote text size",
      "default": 20
    },
    {
      "type": "select",
      "id": "image_shape",
      "label": "Image shape",
      "options": [
        {
          "value": "natural",
          "label": "Natural"
        },
        {
          "value": "landscape",
          "label": "Landscape (5:4)"
        },
        {
          "value": "square",
          "label": "Square (1:1)"
        },
        {
          "value": "portrait",
          "label": "Portrait (4:5)"
        }
      ],
      "default": "square"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "default",
      "options": [
        {
          "value": "default",
          "label": "Default"
        },
        {
          "value": "1",
          "label": "1"
        },
        {
          "value": "2",
          "label": "2"
        }
      ]
    },
    {
      "id": "autoplay",
      "type": "checkbox",
      "label": "Auto-rotate testimonials",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "min": 1,
      "max": 20,
      "step": 1,
      "unit": "s",
      "label": "Change testimonials every",
      "default": 5
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#f7f5f1"
    },
    {
      "type": "range",
      "id": "vertical_padding",
      "label": "Vertical padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 32
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        {
          "type": "range",
          "id": "star_rating",
          "min": 0,
          "max": 5,
          "step": 1,
          "label": "Star rating",
          "default": 5
        },
        {
          "type": "text",
          "id": "testimonial",
          "label": "Testimonial",
          "default": "Add customer reviews and testimonials to showcase your store’s happy customers.",
          "info": "The full endorsement is preserved behind Read full endorsement."
        },
        {
          "type": "text",
          "id": "preview_quote",
          "label": "Preview quote (optional)",
          "info": "Use an exact excerpt. Leave blank to automatically show the first 40 words."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "1000 x 800px recommended"
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author",
          "default": "Author's name"
        },
        {
          "type": "text",
          "id": "sub-heading",
          "label": "Credentials / role",
          "default": "Sub heading"
        },
        {
          "type": "text",
          "id": "image_caption",
          "label": "Image caption"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Image link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Review Testimonials",
      "settings": {},
      "blocks": [
        {
          "type": "testimonial",
          "settings": {}
        },
        {
          "type": "testimonial",
          "settings": {}
        }
      ]
    }
  ]
}
{% endschema %}

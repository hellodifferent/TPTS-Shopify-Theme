{%- liquid
  assign show_promos = false

  if section.blocks.size > 0
    if section.settings.show_on_home_page
      assign show_promos = true
    elsif section.settings.show_on_home_page == false and template != 'index'
      assign show_promos = true
    endif
  endif
-%}

{%- if show_promos -%}
  {%- liquid
    if section.blocks.size == 4
      assign column_width = 'quarter'
    elsif section.blocks.size == 3
      assign column_width = 'third'
    elsif section.blocks.size == 2
      assign column_width = 'half'
    else
      assign column_width = 'full'
    endif
  %}
  <div id="section-id-{{ section.id }}" class="cross-page-promos{% if section.settings.layout_style == 'inline' %} cross-page-promos--inline{% endif %}">
    <div class="container">
      <div class="flexible-layout {% if column_width == 'quarter' %}layout-all-quarters{% endif %}">
        {%- for block in section.blocks -%}
          <div style="--tps-promo-max-width: {{ block.settings.desktop_max_width | default: 260 }}px;" class="column column--{{ column_width }} align-center block-id-{{ block.id }}" {{ block.shopify_attributes }}>
            <div class="relative">
              {% if block.settings.link_url != blank %}
              <a class="block" href="{{ block.settings.link_url }}">
                {% endif %}

                {% if block.type == 'image' %}

                  {% if block.settings.image == blank %}
                    <div class="placeholder-image placeholder-image--shape-landscape {% if block.settings.text != blank %}dark{% endif %}">{{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}</div>
                  {% else %}
                    {%- render 'image' with block.settings.image, size_cols_mobile: 2, size_cols_desktop: section.blocks.size, loading: 'lazy' -%}
                  {% endif %}

                  {% if block.settings.text != blank %}
                  <div class="text-overlay overlay-centre">
                    <div class="text-overlay__inner">
                      <div class="text-overlay__text">
                        <div class="h6 heading-font">{{ block.settings.text | escape }}</div>
                        {% if block.settings.subtext != blank %}<div class="second-line">{{ block.settings.subtext | escape }}</div>{% endif %}
                      </div>
                    </div>
                  </div>
                  {% endif %}

                {% elsif block.type contains 'icon' %}

                  <div class="icon-with-caption">
                    <div class="icon-with-caption__icon">
                      {%- if block.settings.image == blank -%}
                        {%- case block.settings.icon -%}
                          {%- when 'tps_payment' -%}
                            {{ 'tps-promo-payment.svg' | inline_asset_content }}
                          {%- when 'tps_play' -%}
                            {{ 'tps-promo-play.svg' | inline_asset_content }}
                          {%- else -%}
                            {%- render 'icon', icon: block.settings.icon, size: 'medium' -%}
                        {%- endcase -%}
                      {%- else -%}
                        <div class="icon-with-caption__image-icon">
                          {%- render 'image' with block.settings.image, sizes: '34px', widths: '34, 68', loading: 'lazy' -%}
                        </div>
                      {%- endif -%}
                    </div>

                    {% if block.settings.text != blank %}
                      <div class="icon-with-caption__text">
                        <div class="heading-font h6 align-center">{{ block.settings.text }}</div>
                      </div>
                    {% endif %}
                  </div>

                {% endif %}

                {% if block.settings.link_url != blank %}
              </a>
              {% endif %}
            </div>
          </div>
        {%- endfor -%}
      </div>

    </div>
  </div>
{%- endif -%}

{% style %}
  #section-id-{{ section.id }} {
    --bg-color: {{ section.settings.cross_page_promo_bg }};
    --text-color: {{ section.settings.cross_page_promo_color }};
  }

  {%- for block in section.blocks -%}
    {%- if block.type == 'image' and block.settings.text != blank -%}
      .cross-page-promos .block-id-{{ block.id }} .text-overlay .text-overlay__text {
        color: {{ block.settings.overlay_color }};
      }
    {%- endif -%}
  {%- endfor -%}

  #section-id-{{ section.id }} { display: block; }
  #section-id-{{ section.id }}.cross-page-promos--inline .icon--type-heart { stroke: #97745b; }
  #section-id-{{ section.id }}.cross-page-promos--inline { padding: 28px 0 !important; }
  #section-id-{{ section.id }}.cross-page-promos--inline .flexible-layout {
    display: flex;
    flex-wrap: nowrap;
    justify-content: space-between;
    align-items: center;
    gap: {{ section.settings.desktop_gap | default: 32 }}px;
    margin: 0;
  }
  #section-id-{{ section.id }}.cross-page-promos--inline .column {
    flex: 1 1 0;
    width: auto;
    min-width: 0;
    max-width: var(--tps-promo-max-width);
    margin: 0;
    padding: 0;
  }
  #section-id-{{ section.id }}.cross-page-promos--inline .icon-with-caption {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 14px;
  }
  #section-id-{{ section.id }}.cross-page-promos--inline .icon-with-caption__icon {
    flex: 0 0 auto;
    margin: 0;
    padding: 0;
    width: 28px;
    height: 28px;
    border: 0;
    border-radius: 0;
    background: transparent;
    box-shadow: none;
    line-height: 0;
  }
  #section-id-{{ section.id }}.cross-page-promos--inline .icon-with-caption__text { margin: 0; min-width: 0; }
  #section-id-{{ section.id }}.cross-page-promos--inline .icon-with-caption__icon svg,
  #section-id-{{ section.id }}.cross-page-promos--inline .icon-with-caption__image-icon { width: 28px; height: 28px; }
  #section-id-{{ section.id }}.cross-page-promos--inline .icon-with-caption__text .heading-font {
    margin: 0;
    font-family: inherit;
    font-size: clamp(14px, 1.3vw, 16px);
    font-weight: 400;
    line-height: 1.4;
    letter-spacing: normal;
    text-align: left;
    text-transform: none;
  }
  @media (max-width: 767.98px) {
    #section-id-{{ section.id }}.cross-page-promos--inline { padding: 18px 0 !important; }
    #section-id-{{ section.id }}.cross-page-promos--inline .flexible-layout {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 22px 18px;
    }
    #section-id-{{ section.id }}.cross-page-promos--inline .column {
      width: 100% !important;
      max-width: none !important;
      margin: 0 !important;
      padding: 0 !important;
    }
    #section-id-{{ section.id }}.cross-page-promos--inline .icon-with-caption {
      flex-direction: row;
      justify-content: flex-start;
      gap: 8px;
    }
    #section-id-{{ section.id }}.cross-page-promos--inline .icon-with-caption__icon,
    #section-id-{{ section.id }}.cross-page-promos--inline .icon-with-caption__icon svg,
    #section-id-{{ section.id }}.cross-page-promos--inline .icon-with-caption__image-icon {
      width: 22px;
      height: 22px;
    }
    #section-id-{{ section.id }}.cross-page-promos--inline .icon-with-caption__text .heading-font {
      font-size: 12.5px;
      text-align: left;
      white-space: normal;
    }
  }
{% endstyle %}



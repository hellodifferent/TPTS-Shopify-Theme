{%- liquid
  assign hero_heading = section.settings.heading | default: collection.title
  assign hero_offer = section.settings.description
-%}
<tps-sale-hero class="tps-sale-hero" style="--sale-hero-bg: {{ section.settings.background }};">
  <div class="container tps-sale-hero__inner">
    <h1>{{ hero_heading | escape | replace: 'Black Friday at The Playtime Store', 'Black Friday at<br>The Playtime Store' }}</h1>
    <p class="tps-sale-hero__rating" data-sale-rating hidden>
      <a href="{{ pages.reviews.url | default: '/pages/reviews' }}" data-sale-read-reviews></a>
    </p>
    <div class="rte">{{ hero_offer | replace: 'with free shipping on orders over $250.', 'with<br>free shipping on orders over $250.' }}</div>
    <a class="btn" href="#black-friday-products" data-sale-shop>{{ section.settings.button_text | escape }}</a>
  </div>
  <div data-sale-review-source hidden aria-hidden="true">
    {%- for block in section.blocks -%}
      {% render block %}
    {%- endfor -%}
  </div>
</tps-sale-hero>
<script src="{{ 'tps-sale-hero.js' | asset_url }}" defer></script>

{% stylesheet %}
  .tps-sale-hero { display: block; background: var(--sale-hero-bg); }
  .tps-sale-hero__inner { padding-block: clamp(24px, 5vw, 68px); text-align: center; }
  .tps-sale-hero__inner h1 { margin: 0 0 12px; font-size: clamp(32px, 4vw, 58px); line-height: 1.1; }
  .tps-sale-hero__inner .rte p:last-child { margin-bottom: 0; }
  .tps-sale-hero__inner .btn { margin-top: 18px; }
  .tps-sale-hero__rating { margin: 0 0 14px; font-size: 13px; }
  .tps-sale-hero__rating a { color: inherit; }
  .tps-sale-hero__rating a:hover { text-decoration: underline; text-underline-offset: 3px; }
  .tps-sale-hero__stars { margin-inline: 5px; color: #97745b; font-size: 16px; letter-spacing: 1px; }
  #black-friday-products { scroll-margin-top: calc(var(--header-group-height, 100px) + 12px); }
{% endstylesheet %}

{% schema %}
{
  "name": "TPS Black Friday hero",
  "enabled_on": { "templates": ["collection"] },
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Black Friday at The Playtime Store" },
    { "type": "richtext", "id": "description", "label": "Offer copy", "default": "<p>Up to 20% off selected playtime favourites, with free shipping on orders over $250.</p>" },
    { "type": "text", "id": "button_text", "label": "Shop button text", "default": "Shop the sale" },
    { "type": "color", "id": "background", "label": "Background", "default": "#fffaf6" }
  ],
  "blocks": [{ "type": "@app" }]
}
{% endschema %}

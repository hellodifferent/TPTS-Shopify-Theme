{%- liquid
  assign hero_heading = section.settings.heading | default: collection.title
  assign hero_offer = section.settings.description
-%}
<tps-sale-hero class="tps-sale-hero" style="--sale-hero-bg: {{ section.settings.background }};" data-sale-products="{{ collection.products | map: 'title' | json | escape }}">
  <div class="container tps-sale-hero__inner">
    <div class="tps-sale-hero__offer">
      <h1>{{ hero_heading | escape | replace: 'Black Friday at The Playtime Store', 'Black Friday at<br>The Playtime Store' }}</h1>
      <div class="rte">{{ hero_offer | replace: 'with free shipping on orders over $250.', 'with<br>free shipping on orders over $250.' }}</div>
      <a class="btn" href="#black-friday-products" data-sale-shop>{{ section.settings.button_text | escape }}</a>
    </div>
    <div class="tps-sale-hero__reviews">
      <div class="tps-sale-hero__cards">
        <div class="tps-sale-hero__review-card">
          <div class="tps-sale-hero__story" data-sale-story hidden>
            <p class="tps-sale-hero__review-stars" data-sale-review-stars></p>
            <blockquote class="tps-sale-hero__quote" data-sale-quote></blockquote>
            <p class="tps-sale-hero__credit" data-sale-credit></p>
          </div>
          <a href="{{ pages.reviews.url | default: '/pages/reviews' }}" data-sale-read-reviews>{{ section.settings.reviews_link_text | escape }}</a>
        </div>
        <div class="tps-sale-hero__photo" data-sale-photo hidden></div>
      </div>
      <p class="tps-sale-hero__rating" data-sale-rating hidden></p>
    </div>
  </div>
  <div data-sale-review-source hidden aria-hidden="true">
    {%- for block in section.blocks -%}
      {% render block %}
    {%- endfor -%}
  </div>
</tps-sale-hero>
<script src="{{ 'tps-sale-hero.js' | asset_url }}" defer></script>

{% stylesheet %}
  .tps-sale-hero { display: block; background: var(--sale-hero-bg); }
  .tps-sale-hero__inner { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr); align-items: center; gap: clamp(20px, 5vw, 76px); padding-block: clamp(28px, 5vw, 68px); }
  .tps-sale-hero__offer h1 { margin: 0 0 12px; font-size: clamp(32px, 4vw, 58px); line-height: 1.1; text-align: start; }
  .tps-sale-hero__offer .rte p:last-child { margin-bottom: 0; }
  .tps-sale-hero__offer .btn { margin-top: 18px; }
  .tps-sale-hero__reviews { min-width: 0; }
  .tps-sale-hero__cards { display: grid; gap: clamp(8px, 1.5vw, 16px); }
  .tps-sale-hero__cards:has([data-sale-photo]:not([hidden])) { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .tps-sale-hero__rating { margin: 12px 0 0; font-size: 13px; text-align: center; }
  .tps-sale-hero__stars, .tps-sale-hero__review-stars { color: #97745b; letter-spacing: 1px; }
  .tps-sale-hero__stars { margin-inline: 5px; font-size: 16px; }
  .tps-sale-hero__review-card { display: flex; flex-direction: column; align-items: flex-start; background: #fff; border: 1px solid #efe4da; border-radius: 10px; padding: clamp(12px, 2vw, 24px); color: #393735; }
  .tps-sale-hero__photo { position: relative; aspect-ratio: 3 / 4; overflow: hidden; border-radius: 10px; background: #f2e9e0; }
  .tps-sale-hero__photo img { position: absolute; inset: 0; display: block; width: 100%; height: 100%; object-fit: cover; }
  .tps-sale-hero__story:not([hidden]) { display: flex; flex: 1; flex-direction: column; }
  .tps-sale-hero__review-stars { margin: 0 0 10px; font-size: 17px; line-height: 1; }
  .tps-sale-hero__quote { margin: 0 0 14px; padding: 0; border: 0; font: inherit; font-size: clamp(15px, 1.6vw, 17px); line-height: 1.4; text-indent: 0; }
  .tps-sale-hero__quote::before, .tps-sale-hero__quote::after { content: none; }
  .tps-sale-hero__credit { margin: auto 0 8px; font-size: 13px; font-weight: 600; }
  .tps-sale-hero__reviews a { color: inherit; font-size: 13px; text-decoration: underline; text-underline-offset: 3px; }
  #black-friday-products { scroll-margin-top: calc(var(--header-group-height, 100px) + 12px); }
  @media (max-width: 767px) {
    .tps-sale-hero__inner { grid-template-columns: 1fr; gap: 16px; padding-block: 24px; }
    .tps-sale-hero__quote { font-size: 14px; }
    .tps-sale-hero__credit { font-size: 12px; }
    .tps-sale-hero__reviews a { font-size: 12px; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "TPS Black Friday hero",
  "enabled_on": { "templates": ["collection"] },
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Black Friday at The Playtime Store" },
    { "type": "richtext", "id": "description", "label": "Offer copy", "default": "<p>Up to 20% off selected playtime favourites, with free shipping on orders over $250.</p>" },
    { "type": "text", "id": "button_text", "label": "Shop button text", "default": "Shop the sale" },
    { "type": "text", "id": "reviews_link_text", "label": "Reviews link text", "default": "Read reviews" },
    { "type": "color", "id": "background", "label": "Background", "default": "#fffaf6" }
  ],
  "blocks": [{ "type": "@app" }]
}
{% endschema %}

{%- liquid
  assign shipping_url = pages['shipping-delivery-info'].url | default: shop.shipping_policy.url
  assign contact_url = pages['contact-us'].url
  assign faq_url = pages['faqs'].url
  assign review_url = section.settings.review_url
  if review_url == blank and section.blocks.size > 0
    assign review_url = '#thank-you-reviews'
  endif
  assign offer_url = section.settings.offer_collection.url | default: routes.all_products_collection_url
  assign offer_code = section.settings.offer_code | strip
-%}
<section class="tps-thank-you container">
  <header class="tps-thank-you__hero">
    <h1>Thanks for shopping with The Playtime Store!</h1>
    <p>We’re so glad to be part of their playtime. Here’s what to expect next and how to keep in touch.</p>
  </header>

  <div class="tps-thank-you__cards">
    <div class="tps-thank-you__card">
      <h2>Need a hand?</h2>
      <p>Check your confirmation email for your order details. We’ll send tracking once your order ships. If you get in touch, have your order number handy.</p>
      <ul class="tps-thank-you__links" role="list">
        <li><a href="{{ routes.account_url }}">View your orders</a></li>
        <li><a href="{{ contact_url | escape }}">Contact us</a></li>
        <li><a href="{{ shipping_url | escape }}">Shipping &amp; delivery</a></li>
        <li><a href="{{ faq_url | escape }}">FAQs</a></li>
      </ul>
    </div>
    {%- if review_url != blank -%}
      <div class="tps-thank-you__card">
        <h2>How was your playtime?</h2>
        <p>Once you’ve had a chance to play, we’d love to hear what you think. Your honest review helps other families choose what’s right for them.</p>
        <a href="{{ review_url | escape }}">Leave a review</a>
      </div>
    {%- endif -%}
    {%- if settings.social_instagram_url != blank -%}
      <div class="tps-thank-you__card">
        <h2>Show us your play space</h2>
        <p>We’d love to see what you create. Tag @theplaytimestore_ in your Instagram posts or stories.</p>
        <a href="{{ settings.social_instagram_url | escape }}">Find us on Instagram</a>
      </div>
    {%- endif -%}
  </div>

  {%- if section.settings.show_care_video and section.settings.care_video_url != blank -%}
    <section class="tps-thank-you__care" aria-labelledby="thank-you-care-{{ section.id }}">
      <div class="tps-thank-you__care-copy">
        <p class="tps-thank-you__eyebrow">A little care, lots more play</p>
        <h2 id="thank-you-care-{{ section.id }}">{{ section.settings.care_heading | escape }}</h2>
        <div class="rte">{{ section.settings.care_text }}</div>
      </div>
      <tps-care-video class="tps-thank-you__care-media">
        <video id="thank-you-care-video-{{ section.id }}" autoplay muted loop playsinline preload="metadata" aria-label="How to clean your eco-leather play pieces">
          <source src="{{ section.settings.care_video_url | escape }}#t=0.001" type="video/mp4">
          <a href="{{ section.settings.care_video_url | escape }}">Watch the cleaning video</a>
        </video>
        <button type="button" class="tps-thank-you__video-toggle" aria-controls="thank-you-care-video-{{ section.id }}" aria-label="Pause cleaning video" data-pause-label="Pause cleaning video" data-play-label="Play cleaning video" hidden>
          <svg data-pause-icon width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><rect x="4" y="3" width="2.5" height="10" rx=".5"/><rect x="9.5" y="3" width="2.5" height="10" rx=".5"/></svg>
          <svg data-play-icon width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true" hidden><path d="M5 3 13 8 5 13Z"/></svg>
        </button>
      </tps-care-video>
    </section>
  {%- endif -%}

  {%- if section.settings.show_offer and offer_code != blank -%}
    <div class="tps-thank-you__offer">
      <div>
        <h2>Looking to add to your collection?</h2>
        <p>Use <strong class="tps-thank-you__code">{{ offer_code | escape }}</strong> at checkout for free shipping on your next order.</p>
      </div>
      <a class="btn btn--primary" href="{{ routes.root_url | append: '/discount/' | replace: '//', '/' }}{{ offer_code | url_encode }}?redirect={{ offer_url | url_encode }}">Shop with free shipping</a>
    </div>
  {%- endif -%}

  {%- if section.blocks.size > 0 and section.settings.review_url == blank -%}
    <div id="thank-you-reviews" class="tps-thank-you__reviews">
      {%- for block in section.blocks -%}{%- render block -%}{%- endfor -%}
    </div>
  {%- endif -%}
</section>

{% stylesheet %}
  .tps-thank-you { max-width: 1200px; padding-block: clamp(32px, 5vw, 64px); }
  .tps-thank-you__hero { padding: clamp(24px, 5vw, 60px) 20px; background: #f7f1e9; border-radius: 8px; text-align: center; }
  .tps-thank-you__hero h1 { margin: 0 0 12px; font-size: clamp(30px, 4vw, 48px); line-height: 1.15; }
  .tps-thank-you__hero p { max-width: 48ch; margin: 0 auto; }
  .tps-thank-you__cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 250px), 1fr)); gap: 16px; margin-block: 20px; }
  .tps-thank-you__card { padding: 22px; border: 1px solid #ebe5dd; border-radius: 8px; }
  .tps-thank-you h2 { margin: 0 0 8px; font-size: clamp(20px, 2vw, 24px); }
  .tps-thank-you__card p { margin: 0 0 12px; }
  .tps-thank-you__card a { text-decoration: underline; text-underline-offset: 3px; }
  .tps-thank-you__links { display: flex; flex-wrap: wrap; gap: 6px 14px; padding: 0; margin: 0; list-style: none; }
  .tps-thank-you__care { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 280px); align-items: center; gap: clamp(24px, 5vw, 64px); margin-block: 24px; padding: clamp(24px, 4vw, 40px); background: #f7f5f1; border-radius: 8px; }
  .tps-thank-you__eyebrow { margin: 0 0 10px; font-size: 12px; letter-spacing: .04em; color: #716a63; }
  .tps-thank-you__care-copy .rte { max-width: 52ch; }
  .tps-thank-you__care-copy .rte p { margin: 12px 0; }
  .tps-thank-you__care-copy .rte ul { padding-left: 20px; margin: 16px 0 0; }
  .tps-thank-you__care-copy .rte li + li { margin-top: 8px; }
  .tps-thank-you__care-media { display: block; position: relative; width: 100%; max-width: 250px; justify-self: center; }
  .tps-thank-you__care-media video { display: block; width: 100%; height: auto; aspect-ratio: 9 / 16; object-fit: contain; background: #eeeae4; border-radius: 6px; }
  .tps-thank-you__video-toggle { position: absolute; left: 12px; bottom: 12px; display: inline-flex; align-items: center; justify-content: center; width: 36px; height: 36px; min-height: 0; padding: 0; border: 0; border-radius: 50%; background: rgba(255, 255, 255, .92); color: #634c3c; cursor: pointer; box-shadow: 0 1px 4px rgba(0, 0, 0, .08); transition: background-color .15s ease; }
  .tps-thank-you__video-toggle:hover { background: #fff; }
  .tps-thank-you__video-toggle:focus-visible { outline: 2px solid #634c3c; outline-offset: 3px; }
  .tps-thank-you__video-toggle[hidden], .tps-thank-you__video-toggle svg[hidden] { display: none; }
  @media (max-width: 767px) {
    .tps-thank-you__care { grid-template-columns: minmax(0, 1fr); }
  }
  .tps-thank-you__offer { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 16px; padding: clamp(20px, 4vw, 36px); background: #f7f5f1; border-radius: 8px; }
  .tps-thank-you__offer p { margin: 0; }
  .tps-thank-you__code { white-space: nowrap; color: #634c3c; }
  .tps-thank-you__reviews { margin-top: 32px; scroll-margin-top: calc(var(--header-group-height, 80px) + 24px); }
{% endstylesheet %}

{% javascript %}
  if (!customElements.get('tps-care-video')) {
    customElements.define('tps-care-video', class extends HTMLElement {
      connectedCallback() {
        this.controller?.abort();
        this.controller = new AbortController();
        const { signal } = this.controller;
        const video = this.querySelector('video');
        const button = this.querySelector('button');
        if (!video || !button) return;
        const update = () => {
          const paused = video.paused;
          button.setAttribute('aria-label', paused ? button.dataset.playLabel : button.dataset.pauseLabel);
          button.querySelector('[data-pause-icon]').hidden = paused;
          button.querySelector('[data-play-icon]').hidden = !paused;
        };
        video.muted = true;
        button.hidden = false;
        video.addEventListener('play', update, { signal });
        video.addEventListener('pause', update, { signal });
        button.addEventListener('click', () => {
          if (video.paused) video.play().catch(update);
          else video.pause();
        }, { signal });
        update();
        video.play().catch(update);
      }
      disconnectedCallback() {
        this.controller?.abort();
        this.querySelector('video')?.pause();
      }
    });
  }
{% endjavascript %}

{% schema %}
{
  "name": "TPS Thank you",
  "enabled_on": {
    "templates": [
      "page"
    ]
  },
  "settings": [
    {
      "type": "url",
      "id": "review_url",
      "label": "Judge.me review link"
    },
    {
      "type": "checkbox",
      "id": "show_offer",
      "label": "Show free-shipping offer",
      "default": true
    },
    {
      "type": "text",
      "id": "offer_code",
      "label": "Free-shipping code",
      "default": "PLAYTIMEONUS"
    },
    {
      "type": "collection",
      "id": "offer_collection",
      "label": "Offer button collection"
    },
    {
      "type": "header",
      "content": "Eco-leather care"
    },
    {
      "type": "checkbox",
      "id": "show_care_video",
      "label": "Show eco-leather care section",
      "default": true
    },
    {
      "type": "url",
      "id": "care_video_url",
      "label": "Cleaning video MP4 URL"
    },
    {
      "type": "text",
      "id": "care_heading",
      "label": "Care heading",
      "default": "Keeping your eco-leather pieces clean"
    },
    {
      "type": "richtext",
      "id": "care_text",
      "label": "Care guidance",
      "default": "<p>For our eco-leather play pieces, a quick wipe helps keep them ready for the next adventure. Watch our short cleaning guide below.</p><ul><li>Wipe with a soft, damp cloth.</li><li>Avoid harsh chemicals and abrasive cleaners.</li><li>Allow the surface to dry completely before play.</li></ul>"
    }
  ],
  "blocks": [
    {
      "type": "@app"
    }
  ]
}
{% endschema %}

    "collapsible_tabs_z3Gqcr": {
      "type": "collapsible-tabs",
      "blocks": {
        "question_XVbyTj": {
          "type": "question",
          "settings": {
            "title": "Why open-ended play?",
            "answer": "<p>Have you ever wondered why kids love playing with cardboard boxes for so long? Their imagination runs wild, turning the box into a robot, a fort, a tunnel or a punching bag. Open-ended play is an activity that has no pre-determined limitations. The Playtime Store's products encapsulate this concept to help grow your child's creativity and provide endless enjoyment during the most developmental stages of their life. </p>"
          }
        },
        "question_PDGDrM": {
          "type": "question",
          "settings": {
            "title": "What makes our products different?",
            "answer": "<p>At The Playtime Store we pride ourselves on the quality and style of our products. We've worked tirelessly to source the quality that will last the test of time, steering away from low quality items that frequently need replacing. We believe investing in quality provides a more sustainable future for everyone. </p>"
          }
        },
        "question_DY6nhD": {
          "type": "question",
          "settings": {
            "title": "How does it benefit my child?",
            "answer": "<p>Our products are fantastic for your child's development because it encourages creativity, independence, and critical thinking. They learn to challenge themselves, build balance and take risks. </p>"
          }
        },
        "question_JWWUg6": {
          "type": "question",
          "settings": {
            "title": "Do you offer a payment instalment plan?",
            "answer": "<p>Yes!&nbsp;We offer Afterpay, ShopPay and Zip.&nbsp;</p><p>Paypal is also available at checkout.</p>"
          }
        },
        "question_bVa6gE": {
          "type": "question",
          "settings": {
            "title": "What if I change my mind after purchasing?",
            "answer": "<p>The Playtime Store&nbsp;offers all customers a 100% money back guarantee for any change of mind purchases, provided that the following terms are met:</p><ul><li>All returns&nbsp;must be unused and in their original condition (including all original, protective packaging).</li><li>You must complete your return within 30 days of the date of your order and you are responsible for arranging the return and all costs associated with this.</li><li>The original shipping costs to you are not refunded.</li><li>See the full refund policy <a href=\"/policies/refund-policy\" target=\"_blank\" title=\"Refund Policy\">here</a>.</li></ul>"
          }
        }
      },

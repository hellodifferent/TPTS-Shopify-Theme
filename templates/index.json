r","coll_button_style":"primary"}},"featured_collection_4cYPKg":{"type":"featured-collection","disabled":true,"settings":{"title":"Soft Play Sets","collection":"soft-play-all","show_vendor":false,"enable_carousel":true,"grid":4,"rows":1,"color_scheme":"default","show_view_all":true,"full_width":true}},"cdae4c7a-b069-4813-936d-dea66ca6f2ef":{"type":"featured-collection","disabled":true,"settings":{"title":"SHOP clearance sale","collection":"clearance-collection-sep","show_vendor":false,"enable_carousel":true,"grid":4,"rows":1,"color_scheme":"default","show_view_all":true,"full_width":true}},"review_testimonials_74bd3G":{"type":"review-testimonials","blocks":{"testimonial_jWN3qJ":{"type":"testimonial","settings":{"star_rating":0,"testimonial":"As a paediatric occupational therapist, I highly recommend the Playtime Store soft play equipment for children. Their products offer a safe and stimulating environment for kids to explore, develop motor skills, and build confidence. The design promotes sensory integration and encourages social interaction, making it an invaluable tool. I've seen firsthand how it enhances children's physical and cognitive abilities, making playtime not only fun but also therapeutic. I highly recommend the Playtime Store products to fellow therapists and parents for their ability to support and enrich children's development.","image":"shopify:\/\/shop_images\/IMG_1444.jpg","author":"Brooke Ottey","sub-heading":"Paediatric Occupational Therapist","image_caption":"","link":""}},"testimonial_D4GtBi":{"type":"testimonial","settings":{"star_rating":0,"testimonial":"As a pediatric occupational therapist and mother, I have witnessed the positive impact the Playtime Stores soft play equipment and ball pits has on a child’s development and overall well-being. The variety of sensory experiences provided by their play structures enables children to improve their motor skills, balance, coordination,sensory integration and imagination! The soft and safe environment allows children to explore, take risks, and build confidence in all of their abilities. I have seen firsthand how children with various abilities, such as autism, ADHD, and developmental delays, thrive in this inclusive and stimulating environment. The Playtime Store team truly understands the unique needs of children with all abilities and provides a welcoming and therapeutic equipment for them to play, learn, and grow.","image":"shopify:\/\/shop_images\/corina.jpg","author":"Corina Younis","sub-heading":"Pediatric Occupational Therapist","image_caption":"","link":""}},"testimonial_kKKt6h":{"type":"testimonial","settings":{"star_rating":0,"testimonial":"As an Early Child Educator it's so amazing to see carefully designed, quality play equipment that is accessible for families to use in their home environment. From an education perspective the opportunities for motor and cognitive development are endless. Benefits include opportunities for children to develop their gross motor skills through physical challenge and safe risk taking. Cognitive development is extended through the development of skills such as problem solving, concentration and memory recall.","image":"shopify:\/\/shop_images\/laura.png","author":"Laura Newell","sub-heading":"Qualified Early Childhood Educator","image_caption":"","link":""}}},"block_order":["testimonial_jWN3qJ","testimonial_D4GtBi","testimonial_kKKt6h"],"disabled":true,"settings":{"title":"Trusted by Experts","layout":"image-right","text_caps":false,"quote_text_size":14,"quote_text_size_mobile":14,"image_shape":"square","color_scheme":"default","autoplay":false,"autoplay_speed":5}},"scrolling_banner_8AYnik":{"type":"scrolling-banner","blocks":{"text_ezaPem":{"type":"text","disabled":true,"settings":{"text":"FREE Inflatable Pool with purchases over $300","color":"rgba(0,0,0,0)","link":"","use_h1":false,"stencil_all_text":false,"stencil_text":""}},"text_qiD9Ai":{"type":"text","settings":{"text":"Afterpay & Zip Available","color":"rg